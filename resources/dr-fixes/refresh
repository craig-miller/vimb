#!/usr/bin/env python3
"""
Refresh /var/lib/vimb/scripts.js from Dark Reader's upstream fixes-DB.

Fetches dynamic-theme-fixes.config + dark-sites.config from
darkreader/darkreader main, parses them into a compact JSON payload,
inlines that payload into the bootstrap script, prepends the Dark Reader
library shipped by www-client/vimb, and writes the result atomically.

The fork's user_scripts() consults /var/lib/vimb/scripts.js ahead of the
baseline /usr/share/vimb/scripts.js, so once this script has run the
next vimb tab load gets fixes-aware theming.

Usage: vimb-dr-fixes-refresh (no args; run as root, e.g. from cron.weekly)
"""
from __future__ import annotations

import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

BASE_URL = "https://raw.githubusercontent.com/darkreader/darkreader/main/src/config"
DTF_URL = f"{BASE_URL}/dynamic-theme-fixes.config"
DS_URL = f"{BASE_URL}/dark-sites.config"

DARKREADER_JS = Path("/usr/share/vimb/darkreader.js")
BOOTSTRAP_TEMPLATE = Path("/usr/share/vimb-dr-fixes/bootstrap.js")
OUTPUT = Path("/var/lib/vimb/scripts.js")

USER_AGENT = "vimb-dr-fixes-refresh (github.com/craig-miller/vimb-dr-fixes)"
FETCH_TIMEOUT = 60

BLOCK_DELIM = re.compile(r"^\s*={2,}\s*$", re.MULTILINE)
COMMAND_RE = re.compile(r"^[A-Z]+(\s[A-Z]+){0,2}$")

LIST_COMMANDS = {
    "INVERT": "invert",
    "IGNORE INLINE STYLE": "ignoreInlineStyle",
    "IGNORE IMAGE ANALYSIS": "ignoreImageAnalysis",
    "IGNORE CSS URL": "ignoreCSSUrl",
}
STRING_COMMANDS = {"CSS": "css"}
FLAG_COMMANDS = {"DISABLE STYLE SHEETS PROXY": "disableStyleSheetsProxy"}


def fetch(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT) as resp:
        return resp.read().decode("utf-8")


def parse_block(block_text: str) -> dict | None:
    lines = block_text.split("\n")
    cmd_indices = [i for i, ln in enumerate(lines) if COMMAND_RE.match(ln)]
    if not cmd_indices:
        return None
    urls = [ln.strip() for ln in lines[: cmd_indices[0]] if ln.strip()]
    if not urls:
        return None

    fix: dict = {"urls": urls}
    for i, cmd_idx in enumerate(cmd_indices):
        cmd = lines[cmd_idx].strip()
        end = cmd_indices[i + 1] if i + 1 < len(cmd_indices) else len(lines)
        raw = lines[cmd_idx + 1 : end]

        if cmd in LIST_COMMANDS:
            values = [ln.strip() for ln in raw if ln.strip()]
            if values:
                fix[LIST_COMMANDS[cmd]] = values
        elif cmd in STRING_COMMANDS:
            value = "\n".join(raw).strip()
            if value:
                fix[STRING_COMMANDS[cmd]] = value
        elif cmd in FLAG_COMMANDS:
            fix[FLAG_COMMANDS[cmd]] = True
    return fix


def parse_dynamic_fixes(text: str) -> tuple[dict, list[dict]]:
    common_fix: dict = {}
    site_fixes: list[dict] = []
    for block in BLOCK_DELIM.split(text):
        parsed = parse_block(block)
        if parsed is None:
            continue
        if parsed["urls"] == ["*"]:
            common_fix = {k: v for k, v in parsed.items() if k != "urls"}
        else:
            site_fixes.append(parsed)
    return common_fix, site_fixes


def parse_dark_sites(text: str) -> list[str]:
    return [ln.strip() for ln in text.splitlines() if ln.strip()]


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        prefix=".scripts.js.", suffix=".tmp", dir=str(path.parent)
    )
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp_name, 0o644)
        os.replace(tmp_name, path)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    if not DARKREADER_JS.is_file():
        print(
            f"error: {DARKREADER_JS} missing — is www-client/vimb installed?",
            file=sys.stderr,
        )
        return 1
    if not BOOTSTRAP_TEMPLATE.is_file():
        print(
            f"error: {BOOTSTRAP_TEMPLATE} missing — reinstall vimb-dr-fixes",
            file=sys.stderr,
        )
        return 1

    try:
        dtf_text = fetch(DTF_URL)
        ds_text = fetch(DS_URL)
    except urllib.error.URLError as e:
        print(f"error: fetch failed: {e}", file=sys.stderr)
        return 1

    common_fix, site_fixes = parse_dynamic_fixes(dtf_text)
    dark_sites = parse_dark_sites(ds_text)
    fixes_json = json.dumps(
        {
            "commonFix": common_fix,
            "siteFixes": site_fixes,
            "darkSites": dark_sites,
        },
        separators=(",", ":"),
    )

    darkreader_js = DARKREADER_JS.read_text()
    bootstrap = BOOTSTRAP_TEMPLATE.read_text()
    if "__DR_FIXES__" not in bootstrap:
        print(
            f"error: {BOOTSTRAP_TEMPLATE} has no __DR_FIXES__ sentinel",
            file=sys.stderr,
        )
        return 1
    bootstrap_inlined = bootstrap.replace("__DR_FIXES__", fixes_json)
    output = darkreader_js.rstrip() + "\n" + bootstrap_inlined

    atomic_write(OUTPUT, output)

    print(
        f"refreshed {OUTPUT}: siteFixes={len(site_fixes)}, "
        f"darkSites={len(dark_sites)}, size={OUTPUT.stat().st_size} bytes"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
